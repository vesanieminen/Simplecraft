{
  "name": "elocraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A controller-first, split-screen multiplayer voxel sandbox for kids.",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "express": "^4.21.2",
    "three": "^0.171.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/three": "^0.171.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
